name: Starter checks
on:
  push:
    branches: [main]
  pull_request:
permissions:
  contents: read
jobs:
  starter:
    name: Starter checks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.9'
      - run: python -m unittest discover -s tests -v
